{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uae-document-intelligence:phase3:dataset:1.0",
  "title": "Phase 3 evaluation dataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_schema_version",
    "dataset_id",
    "dataset_version",
    "purpose",
    "claim_eligible",
    "normalization",
    "samples"
  ],
  "properties": {
    "dataset_schema_version": {"const": "1.0"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "claim_eligible": {"type": "boolean"},
    "claim_exclusion_reason": {"type": ["string", "null"], "minLength": 1},
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "strict-normalized-value"},
        "version": {"const": "1.0"}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sample"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"claim_eligible": {"const": false}}},
      "then": {"required": ["claim_exclusion_reason"]}
    },
    {
      "if": {"properties": {"claim_eligible": {"const": true}}},
      "then": {
        "properties": {
          "samples": {
            "items": {
              "properties": {
                "source": {
                  "properties": {"synthetic": {"const": false}}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "occurrence", "value_type", "value", "normalized_value"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "occurrence": {"type": "integer", "minimum": 0},
        "value_type": {
          "enum": ["String", "Decimal", "Date", "Currency", "Identifier"]
        },
        "value": {"type": "string"},
        "normalized_value": {"type": ["string", "null"]}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_id", "source", "segments", "ground_truth"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "license", "synthetic"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "license": {"type": "string", "minLength": 1},
            "synthetic": {"type": "boolean"}
          }
        },
        "segments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layout", "scan_type", "language"],
          "properties": {
            "layout": {"type": "string", "minLength": 1},
            "scan_type": {"type": "string", "minLength": 1},
            "language": {"type": "string", "minLength": 1}
          }
        },
        "ground_truth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {
              "type": "array",
              "items": {"$ref": "#/$defs/field"}
            }
          }
        }
      }
    }
  }
}
