{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uae-document-intelligence:phase3:readiness-audit:1.0",
  "title": "Phase 3 dataset readiness audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audit_schema_version",
    "auditor_version",
    "dataset",
    "input_fingerprints",
    "checks",
    "claim_ready",
    "blocker_count",
    "blockers"
  ],
  "properties": {
    "audit_schema_version": {"const": "1.0"},
    "auditor_version": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sample_count", "claim_eligible"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sample_count": {"type": "integer", "minimum": 1},
        "claim_eligible": {"type": "boolean"}
      }
    },
    "input_fingerprints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_canonical_sha256",
        "source_register_canonical_sha256",
        "annotation_ledger_canonical_sha256"
      ],
      "properties": {
        "dataset_canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_register_canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "annotation_ledger_canonical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "claim_ready": {"type": "boolean"},
    "blocker_count": {"type": "integer", "minimum": 0},
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "summary"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "sample_id": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
