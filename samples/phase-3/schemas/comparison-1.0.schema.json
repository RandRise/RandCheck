{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uae-document-intelligence:phase3:comparison:1.0",
  "title": "Phase 3 evaluation report comparison",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "comparison_schema_version",
    "comparator_version",
    "dataset",
    "baseline",
    "candidate",
    "metrics",
    "breakdowns",
    "thresholds"
  ],
  "properties": {
    "comparison_schema_version": {"const": "1.0"},
    "comparator_version": {"type": "string", "minLength": 1},
    "dataset": {"type": "object"},
    "baseline": {"type": "object"},
    "candidate": {"type": "object"},
    "metrics": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/metricComparison"}
    },
    "breakdowns": {"type": "object"},
    "thresholds": {
      "type": ["object", "null"]
    }
  },
  "$defs": {
    "nullableNumber": {"type": ["number", "null"]},
    "metricComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "delta",
        "favorable_delta",
        "direction"
      ],
      "properties": {
        "baseline": {"$ref": "#/$defs/nullableNumber"},
        "candidate": {"$ref": "#/$defs/nullableNumber"},
        "delta": {"$ref": "#/$defs/nullableNumber"},
        "favorable_delta": {"$ref": "#/$defs/nullableNumber"},
        "direction": {"enum": ["higher_is_better", "lower_is_better"]}
      }
    }
  }
}
