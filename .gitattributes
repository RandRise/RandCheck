# P2-T03 hashes require byte-identical checkout across Windows and Linux.
/.gitattributes text eol=lf
/apps/api/app/fixture_contract.py text eol=lf
/apps/api/app/local_extraction.py text eol=lf
/apps/api/tests/goldens/local-provider/** text eol=lf
/tools/phase2-fixtures-requirements.txt text eol=lf
/tools/phase2-fixtures.Dockerfile text eol=lf
/tools/phase2_fixture_source.json text eol=lf
/tools/phase2_fixtures.py text eol=lf
/tools/phase2_local_provider_goldens.py text eol=lf
/samples/phase-2/** text eol=lf
/samples/phase-2/generated/** binary
/samples/phase-2/licenses/** binary

# CI shell entry points must execute after Windows checkouts.
/tools/ci/*.sh text eol=lf
/samples/phase-4/procurement-v0.1.0/*.json text eol=lf
/samples/phase-4/procurement-v0.1.0/*.pdf binary
/samples/phase-5/due-date-v0.1.0/*.pdf binary
# Preserve byte-pinned Phase 5 JSON when core.autocrlf is enabled.
/samples/phase-5/**/*.json -text
/tools/phase4_procurement_source_v0.1.0.json text eol=lf
