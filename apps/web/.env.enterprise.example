# Public deployment configuration. No client secret belongs in this application.
# Set these before building. Production defaults to Locked when AUTH_MODE is absent.
AUTH_MODE=Entra
NEXT_PUBLIC_ENTRA_TENANT_ID=YOUR_TENANT_GUID
NEXT_PUBLIC_ENTRA_CLIENT_ID=YOUR_SPA_CLIENT_GUID
NEXT_PUBLIC_ENTRA_SCOPE=api://YOUR_API_CLIENT_GUID/DocumentIntelligence.Access
NEXT_PUBLIC_API_URL=https://YOUR_API_HOST
# Register the exact SPA redirect URL: https://YOUR_WEB_HOST/auth/callback
# Set the API's Cors:Origins to the exact web origin, and its AllowedClientIds to the SPA GUID.
