APP_ENV=development
ConnectionStrings__Database=Host=localhost;Port=55432;Database=document_intelligence;Username=document_intelligence;Password=local_development_only
Storage__UploadDirectory=./data/uploads
Storage__MaxUploadBytes=10485760
AiService__BaseUrl=http://localhost:8001
AiService__ProviderAlias=local
AiService__AdapterVersion=local-1.0.0
AiService__SchemaVersion=2.0
AiService__WorkerToken=replace_with_a_random_local_secret
# Keep disabled until PostgreSQL migrations are applied and Python shares Storage__UploadDirectory.
ExtractionWorker__Enabled=false
ExtractionWorker__PollIntervalMilliseconds=1000
StorageMaintenance__Enabled=false
StorageMaintenance__OrphanGraceMinutes=60
StorageMaintenance__CleanupIntervalMinutes=30
Cors__Origins__0=http://localhost:3000
EXTRACTION_PROVIDER=mock
STORAGE_SHARED_ROOT=./data/uploads
WORKER_SHARED_SECRET=replace_with_the_same_random_local_secret
# Arbitrary-path compatibility stays disabled; workers use authenticated /internal/extractions.
ENABLE_LEGACY_EXTRACT=false
OCR_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=30
OCR_RENDER_DPI=300
OCR_TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata
NEXT_PUBLIC_API_URL=http://localhost:8080
# Future Azure adapter (unused by mock provider)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
